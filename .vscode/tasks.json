{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Project",
      "type": "shell",
      "command": "javac",
      "args": [
        "-d",
        "bin",
        "-cp",
        "lib/mysql-connector-j-8.3.0.jar;src/main/java",
        "src/main/java/com/facultyrepository/model/*.java",
        "src/main/java/com/facultyrepository/db/*.java",
        "src/main/java/com/facultyrepository/dao/*.java",
        "src/main/java/com/facultyrepository/util/*.java",
        "src/main/java/com/facultyrepository/ui/*.java",
        "src/main/java/com/facultyrepository/Main.java"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$javac"]
    },
    {
      "label": "Run Application",
      "type": "shell",
      "command": "java",
      "args": [
        "-cp",
        "bin;lib/mysql-connector-j-8.3.0.jar;src/main/resources",
        "com.facultyrepository.Main"
      ],
      "dependsOn": ["Build Project"],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
